---
import PrimaryLayout from "../layouts/PrimaryLayout.astro";
import HeroImg from "../assets/images/robot.svg";
---

<PrimaryLayout title="Home">
	<section class="hero-section">
		<p class="hero-intro">
			I build across software, AI, and robotics. From web apps to
			embedded systems and machine learning, I’m exploring the space where
			code, intelligence, and the physical world meet, and I document every
			step of it. Still learning, always building.
		</p>
		<HeroImg class="hero-img" />
	</section>

	<section class="section">
		<h2>Project</h2>
		<p>Coming soon!</p>
	</section>
</PrimaryLayout>

<style>
	.hero-section {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 2rem;
		align-items: center;
		min-height: 65vh;
	}

	.hero-img {
		max-width: 500px;
		max-height: 500px;
		width: 100%;
		height: auto;
		display: block;
	}

	@media (max-width: 768px) {
		.hero-section {
			grid-template-columns: 1fr;
			min-height: 0;
			margin-top: 3rem;
		}

		.hero-img {
			display: none;
		}

		.section {
			padding-top: 3rem;
		}
	}
</style>
