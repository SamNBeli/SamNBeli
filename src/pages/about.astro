---
import PrimaryLayout from '../layouts/PrimaryLayout.astro';
import TimelineCard from "../components/TimelineCard.astro";
---

<PrimaryLayout title = "About Me">
	<section class="col">
        <h1 class="title">
		    Timeline
	    </h1>
        <div class="contents">
            <div class="box">
                <TimelineCard date="September 2025" 
                      school="ULaval" 
                      title="D.E.S.S in Artificial intelligence"
                      description="Graduate diploma focused on machine learning, deep learning, and data science applications."
                      achievements={[
                                "Expected completion: Fall 2026",
                                "Courses include NLP, neural networks, big data processing, and AI for autonomous systems",
                                "Will use Python, PyTorch, and TensorFlow and a lot more"
                        ]}/>
            </div>
            <div class="box">
                <TimelineCard date="January 2018 to December 2021" 
                      school="UQO" 
                      title="B.Sc. in Computer Science"
                      description="Studied core computer science foundations."
                      achievements={[
                                "Studied algorithms, data structures, and project management",
                                "Completed final project: a RESTful API that compile Java code",
                                "Learned Java, python, SQL"
                        ]}/>
            </div>
            
        </div>
        


    </section>
    
</PrimaryLayout>

<style>
    .col {
        margin-top: 3rem;
    }
    .col .contents{
        padding: 0px 30px;
        border-left: 2px solid #111;
        position: relative;
    }

        .box {
        position: relative;
    }
    .box::before {
        content: "";
        position: absolute;
        left: -37px;
        top: 0.5rem;
        width: 12px;
        height: 12px;
        background: white;
        border-radius: 50%;
        border: 2px solid black;
    }
</style>